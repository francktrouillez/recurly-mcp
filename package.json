{
  "name": "recurly-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP (Model Context Protocol) server exposing the Recurly v2021-02-25 API to LLM clients — accounts, subscriptions, invoices, transactions, plans, coupons, line items, and the rest of Recurly's read surface.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "recurly",
    "billing",
    "subscriptions",
    "invoicing",
    "payments",
    "llm-tools",
    "ai-tools"
  ],
  "author": "Franck Trouillez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francktrouillez/recurly-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/francktrouillez/recurly-mcp/issues"
  },
  "homepage": "https://github.com/francktrouillez/recurly-mcp#readme",
  "type": "module",
  "bin": {
    "recurly-mcp": "dist/bin.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-mcp.mjs 31",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "globals": "^17.6.0",
    "nock": "^14.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8"
  }
}
