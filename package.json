{
  "name": "recurly-mcp",
  "version": "0.2.0",
  "description": "Read-only MCP (Model Context Protocol) server exposing the Recurly v2021-02-25 API to LLM clients — accounts, subscriptions, invoices, transactions, plans, coupons, line items, and the rest of Recurly's read surface.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "recurly",
    "billing",
    "subscriptions",
    "invoicing",
    "payments",
    "llm-tools",
    "ai-tools"
  ],
  "author": "Franck Trouillez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/francktrouillez/recurly-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/francktrouillez/recurly-mcp/issues"
  },
  "homepage": "https://github.com/francktrouillez/recurly-mcp#readme",
  "type": "module",
  "bin": {
    "recurly-mcp": "dist/bin.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "dev": "tsx src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'scripts/**/*.ts'",
    "typecheck": "tsc -p tsconfig.scripts.json",
    "validate": "node scripts/validate-mcp.mjs 31",
    "parity": "tsx scripts/check-parity.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "nock": "^14.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
